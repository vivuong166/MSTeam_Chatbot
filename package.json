{
  "name": "chatbot-gr1",
  "version": "1.0.0",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "bot": "ts-node-dev --respawn --transpile-only scripts/teamsBot.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "db:migrate:bot-control": "ts-node scripts/migrateBotControl.ts",
    "test:toolhub": "npm run build && node --test dist/src/services/toolhubClient.test.js",
    "test:agent": "npm run build && node --test dist/src/agent/intentRouter.test.js dist/src/agent/chatService.test.js",
    "test": "npm run build && node --test dist/src/services/toolhubClient.test.js dist/src/agent/intentRouter.test.js dist/src/agent/chatService.test.js dist/src/control/botControlService.test.js",
    "toolhub:search": "ts-node scripts/toolhubSearch.ts"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-fetch": "^3.3.2",
    "pg": "^8.20.0",
    "selenium-webdriver": "^4.33.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.10.9",
    "@types/selenium-webdriver": "^4.1.22",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
